<Window x:Class="AiUsageWidget.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Background="#11151D" Foreground="#EAEFF7" FontFamily="Yu Gothic UI, Segoe UI" Title="AI Usage Widget" Width="360" Height="700" MinWidth="340" MinHeight="340" WindowStyle="None" ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,32,0,0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SkillFilter" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#CBD5E4"/><Setter Property="Background" Value="#222B39"/><Setter Property="Padding" Value="4,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="#46536A" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><Border x:Name="FocusRing" Margin="2" BorderBrush="#EAEFF7" BorderThickness="1" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#23483F"/><Setter TargetName="Chip" Property="BorderBrush" Value="#6CE6C0"/><Setter Property="Foreground" Value="#6CE6C0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#CBD5E4"/><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Backplate" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Backplate" Property="Background" Value="#263143"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Backplate" Property="Background" Value="#354257"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Backplate" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Backplate" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Backplate" Property="Background" Value="#9C2115"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="CapabilityRow">
      <Border Padding="7,7" BorderBrush="#2B3443" BorderThickness="0,0,0,1" ToolTip="{Binding Description}">
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#151B24"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263143"/></Trigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="10" Foreground="#9BAAC0" TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
  <Grid Height="32" VerticalAlignment="Top" Margin="8,0,218,0" Panel.ZIndex="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#CBD5E4" TextTrimming="CharacterEllipsis" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
  </Grid>
  <Button x:Name="DesktopMenuButton" Style="{StaticResource CaptionButton}" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,178,0" Content="&#xE712;" ToolTip="その他" AutomationProperties.Name="その他" Click="DesktopMenuClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="10">
    <Button.ContextMenu><ContextMenu><MenuItem x:Name="DesktopDockItem" Header="デスクトップの端に表示" IsCheckable="True" Click="DesktopDockClick"/></ContextMenu></Button.ContextMenu>
  </Button>
  <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,138,0" ToolTip="最前面に固定" Click="PinClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="10">
    <Path x:Name="PinGlyph" Width="16" Height="16" Data="M5,1 L11,1 L10,3 L10,7 L12,9 L12,10 L9,10 L8,15 L7,10 L4,10 L4,9 L6,7 L6,3 Z" Stroke="#CBD5E4" StrokeThickness="1" Fill="Transparent" RenderTransformOrigin="0.5,0.5"/>
  </Button>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="最大化" AutomationProperties.Name="最大化" Click="MaximizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="閉じる" AutomationProperties.Name="閉じる" Click="CloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
  </StackPanel>
  <Border Margin="0,32,0,0" BorderBrush="#344052" BorderThickness="1" Padding="16,12">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="DragArea" Background="Transparent" MouseLeftButtonDown="DragHeader" Cursor="SizeAll" ToolTip="ドラッグして移動">
            <TextBlock VerticalAlignment="Center" Text="AI USAGE" FontFamily="Segoe UI" FontSize="11" Foreground="#6CE6C0" FontWeight="SemiBold"/>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="↻" ToolTip="今すぐ更新" Click="RefreshClick" Margin="0,0,5,0"/><Button Content="−" ToolTip="トレイへ収納" Click="HideClick"/></StackPanel>
        </Grid>
      </StackPanel>
      <Border x:Name="SystemUsagePanel" DockPanel.Dock="Top" Background="#1A202B" CornerRadius="9" Padding="10" Margin="0,0,0,12" BorderBrush="#2B3443" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel ToolTip="PC全体のCPU使用率">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="14" FontWeight="SemiBold" Foreground="#6CE6C0"/></Grid>
            <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" Foreground="#6CE6C0" Margin="0,7,0,0" AutomationProperties.Name="CPU使用率"/>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Background="#344052"/>
          <StackPanel Grid.Column="2" ToolTip="{Binding MemoryDetail}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="メモリ" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="14" FontWeight="SemiBold" Foreground="#7FC3FA"/></Grid>
            <ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Foreground="#7FC3FA" Margin="0,7,0,0" AutomationProperties.Name="物理メモリ使用率"/>
            <TextBlock Text="{Binding MemoryAmount}" HorizontalAlignment="Right" FontSize="10" Foreground="#99A8BE" Margin="0,6,0,0" AutomationProperties.AutomationId="MemoryAmount"/>
          </StackPanel>
        </Grid>
      </Border>
      <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0" Content="設定" Click="SettingsClick" Padding="10,5"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource WidgetScrollBar}"/></ScrollViewer.Resources>
        <StackPanel>
          <Border x:Name="GpuPanel" Visibility="Collapsed" Background="#1A202B" CornerRadius="9" Padding="10" Margin="0,0,0,10" BorderBrush="#2B3443" BorderThickness="1">
            <Expander x:Name="GpuSection" Header="GPU" IsExpanded="False" FontSize="11">
              <StackPanel>
                <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions><TextBlock Text="GPU" Foreground="#9BAAC0" FontSize="10"/><TextBlock Grid.Column="1" Text="GPU使用率" Foreground="#9BAAC0" FontSize="10"/><StackPanel Grid.Column="2"><TextBlock Text="GPUメモリ" Foreground="#9BAAC0" FontSize="10"/><TextBlock Text="使用 / 最大" Foreground="#9BAAC0" FontSize="9"/></StackPanel></Grid>
                <ItemsControl x:Name="GpuRows"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="#2B3443" BorderThickness="0,1,0,0" Padding="0,8,0,6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,7,0"><TextBlock Text="{Binding Label}" FontSize="11"/><TextBlock Text="{Binding Name}" Foreground="#9BAAC0" FontSize="9" TextWrapping="Wrap" ToolTip="{Binding Name}"/></StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Usage}" Visibility="{Binding UsageBarVisibility}" FontSize="14" FontWeight="SemiBold" Foreground="#6CE6C0"/><ProgressBar Value="{Binding Used, Mode=OneWay}" Maximum="100" Foreground="#6CE6C0" Margin="0,5,0,0" Visibility="{Binding UsageBarVisibility}"/></StackPanel>
                      <StackPanel Grid.Column="2"><StackPanel Visibility="{Binding DedicatedVisibility}"><TextBlock Text="専用 GPU メモリ" Foreground="#7FC3FA" FontSize="10"/><TextBlock Text="{Binding DedicatedAmount}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel><StackPanel Visibility="{Binding SharedVisibility}" Margin="0,6,0,0"><TextBlock Text="共有 GPU メモリ" Foreground="#99A8BE" FontSize="10"/><TextBlock Text="{Binding SharedAmount}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Expander>
          </Border>
          <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="#1A202B" CornerRadius="9" Padding="10" Margin="0,0,0,10" BorderBrush="#2B3443" BorderThickness="1">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <DockPanel LastChildFill="True" Margin="0,0,5,0">
                      <TextBlock Text="{Binding Name}" Foreground="{Binding Accent}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#9BAAC0" FontSize="10" VerticalAlignment="Center"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Quotas}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,3">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Remaining}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Color}" Margin="6,0,0,0"/></Grid>
                    <TextBlock Visibility="{Binding AmountVisibility}" Text="{Binding Amount}" Foreground="#CBD5E4" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/><ProgressBar Value="{Binding Used, Mode=OneWay}" Maximum="100" Foreground="{Binding Color}" Margin="0,5,0,5"/><TextBlock Visibility="{Binding ResetVisibility}" Text="{Binding Reset}" Foreground="#99A8BE" FontSize="10" TextWrapping="Wrap"/>
                  </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Expander Header="詳細" FontSize="10" Margin="0,3,0,3">
                    <StackPanel Margin="8,2,0,0">
                  <TextBlock Text="{Binding Plan}" Foreground="#9BAAC0" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6"/>
                  <ItemsControl ItemsSource="{Binding DetailLocations}" Margin="0,2,0,6"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Foreground="#9BAAC0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#CBD5E4" FontFamily="Cascadia Mono, Consolas" FontSize="9" TextWrapping="Wrap"/>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Border Visibility="{Binding ResetStatusVisibility}" Background="#151B24" BorderBrush="#2B3443" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,7">
                    <StackPanel>
                      <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="利用上限のリセット" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding ResetStatus.Availability}" Foreground="#6CE6C0" FontSize="10" Margin="8,0,0,0"/>
                      </Grid>
                      <TextBlock Text="{Binding ResetStatus.LimitState}" Foreground="#7F91AC" FontSize="9" Margin="0,0,0,5"/>
                      <ItemsControl ItemsSource="{Binding ResetStatus.Credits}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="#2B3443" BorderThickness="0,1,0,0" Padding="0,7,0,6">
                          <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"/>
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#9BAAC0" FontSize="9" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding Expires}" Foreground="#9BAAC0" FontSize="9" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Granted}" Foreground="#7F91AC" FontSize="9" Margin="0,1,0,0"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Border>
                  <Expander Header="{Binding ModelsLabel}" FontSize="10" Margin="0,3,0,3">
                    <StackPanel Margin="0,5,0,0">
                      <Grid Margin="0,0,0,7">
                        <TextBox Text="{Binding ModelSearch, UpdateSourceTrigger=PropertyChanged}" Background="#151B24" Foreground="#EAEFF7" CaretBrush="#6CE6C0" BorderBrush="#46536A" Padding="7,6" FontSize="11" AutomationProperties.Name="モデル名・識別子で検索"/>
                        <TextBlock Text="モデル名・識別子で検索" Foreground="#9BAAC0" Margin="8,7" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ModelSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </Grid>
                      <Border Background="#263143" Padding="7,6" CornerRadius="4,4,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Text="モデル" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="識別子" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                      <ItemsControl ItemsSource="{Binding FilteredModels}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Padding="7,7" BorderBrush="#2B3443" BorderThickness="0,0,0,1" ToolTip="{Binding Description}">
                          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#151B24"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263143"/></Trigger></Style.Triggers></Style></Border.Style>
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="10" Foreground="#9BAAC0" TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <TextBlock Text="{Binding ModelsMessage}" Visibility="{Binding ModelsMessageVisibility}" Foreground="#9BAAC0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Expander>
                  <Expander Header="{Binding SkillsLabel}" FontSize="10" Margin="0,3,0,3">
                    <StackPanel Margin="0,5,0,0">
                      <Grid Margin="0,0,0,6">
                        <TextBox Text="{Binding SkillSearch, UpdateSourceTrigger=PropertyChanged}" Background="#151B24" Foreground="#EAEFF7" CaretBrush="#6CE6C0" BorderBrush="#46536A" Padding="7,6" FontSize="11" AutomationProperties.Name="スキル名で検索"/>
                        <TextBlock Text="スキル名で検索" Foreground="#9BAAC0" Margin="8,7" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SkillSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </Grid>
                      <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                        <RadioButton Style="{StaticResource SkillFilter}" Content="すべて" IsChecked="{Binding AllSkills}" Margin="0,0,4,0"/>
                        <RadioButton Grid.Column="1" Style="{StaticResource SkillFilter}" Content="ユーザー" IsChecked="{Binding UserSkills}" Margin="0,0,4,0"/>
                        <RadioButton Grid.Column="2" Style="{StaticResource SkillFilter}" Content="プラグイン提供" IsChecked="{Binding PluginSkills}"/>
                      </Grid>
                      <Border Background="#263143" Padding="7,6" CornerRadius="4,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="スキル" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="種別" Margin="8,0,0,0" FontWeight="SemiBold"/></Grid></Border>
                      <ItemsControl ItemsSource="{Binding FilteredSkills}" ItemTemplate="{StaticResource CapabilityRow}"/>
                    </StackPanel>
                  </Expander>
                  <Expander Header="{Binding PluginsLabel}" FontSize="10" Margin="0,3,0,3">
                    <StackPanel Margin="0,5,0,0">
                      <Grid Margin="0,0,0,7">
                        <TextBox Text="{Binding PluginSearch, UpdateSourceTrigger=PropertyChanged}" Background="#151B24" Foreground="#EAEFF7" CaretBrush="#6CE6C0" BorderBrush="#46536A" Padding="7,6" FontSize="11" AutomationProperties.Name="プラグイン名で検索"/>
                        <TextBlock Text="プラグイン名で検索" Foreground="#9BAAC0" Margin="8,7" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PluginSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </Grid>
                      <Border Background="#263143" Padding="7,6" CornerRadius="4,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="プラグイン" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="バージョン / 状態" Margin="8,0,0,0" FontWeight="SemiBold"/></Grid></Border>
                      <ItemsControl ItemsSource="{Binding FilteredPlugins}" ItemTemplate="{StaticResource CapabilityRow}"/>
                    </StackPanel>
                  </Expander>
                  <Expander Header="{Binding McpLabel}" FontSize="10" Margin="0,3,0,3">
                    <StackPanel Margin="0,5,0,0">
                      <Grid Margin="0,0,0,7">
                        <TextBox Text="{Binding McpSearch, UpdateSourceTrigger=PropertyChanged}" Background="#151B24" Foreground="#EAEFF7" CaretBrush="#6CE6C0" BorderBrush="#46536A" Padding="7,6" FontSize="11" AutomationProperties.Name="MCP名で検索"/>
                        <TextBlock Text="MCP名で検索" Foreground="#9BAAC0" Margin="8,7" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding McpSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </Grid>
                      <Border Background="#263143" Padding="7,6" CornerRadius="4,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="MCP サーバー" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="状態" Margin="8,0,0,0" FontWeight="SemiBold"/></Grid></Border>
                      <ItemsControl ItemsSource="{Binding FilteredMcpServers}" ItemTemplate="{StaticResource CapabilityRow}"/>
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="{Binding CapabilitiesMessage}" Visibility="{Binding CapabilitiesMessageVisibility}" Foreground="#9BAAC0" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,2"/>
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="#E7BC8A" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Visibility="{Binding UpdatedVisibility}" Text="{Binding Updated}" FontSize="9" Foreground="#7F91AC" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander x:Name="HistorySection" Header="履歴" Expanded="HistoryExpanded"><StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10"><Button Content="7日" Click="SevenDays" Margin="0,0,8,0"/><Button Content="30日" Click="ThirtyDays"/></StackPanel>
            <StackPanel x:Name="Charts"/>
          </StackPanel></Expander>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
  </Grid>
</Window>
