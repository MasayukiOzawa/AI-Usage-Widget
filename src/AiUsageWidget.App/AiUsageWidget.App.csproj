<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AiUsageWidget</AssemblyName>
    <ApplicationIcon>Assets\AiUsageWidget.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../AiUsageWidget.Core/AiUsageWidget.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <None Remove="Assets\AiUsageWidget.ico" />
    <Content Include="Assets\AiUsageWidget.ico" TargetPath="AiUsageWidget.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSES\MIT.txt" Link="LICENSES\MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSES\Apache-2.0.txt" Link="LICENSES\Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSES\SQLite.txt" Link="LICENSES\SQLite.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
